# Fastlane configuration for Fidel Learn
# https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV['CI']
  end

  desc "Run tests"
  lane :test do
    run_tests(
      scheme: "FidelLearn",
      devices: ["iPhone 16"],
      clean: true
    )
  end

  desc "Run lint checks"
  lane :lint do
    sh("swiftlint lint --strict")
    sh("swiftformat --lint .")
  end

  desc "Build the app"
  lane :build do
    sh("tuist generate")
    increment_build_number(
      xcodeproj: "FidelLearn.xcodeproj"
    )
    build_app(
      scheme: "FidelLearn",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "FidelLearn.ipa",
      clean: true
    )
  end

  desc "Deploy to TestFlight"
  lane :beta do
    lint
    test
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy to App Store"
  lane :release do
    beta
    # Additional release steps
  end

  private_lane :setup_ci do
    ENV["MATCH_PASSWORD"] = ENV["MATCH_PASSWORD"] || ""
  end
end
